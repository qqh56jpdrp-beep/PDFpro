<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>PDFPro Tools — Convert, Edit & Manage PDFs</title>
  <meta name="description" content="PDFPro Tools — All PDF tools in one simple, powerful platform. Merge, Split, Compress, Convert and more."/>
  <style>
    /* -------------------------
       Variables & base
    -------------------------*/
    :root{
      --bg-1: #eaf4ff;
      --bg-2: #d9ecff;
      --accent: #1565d8;
      --accent-2: #2b8cff;
      --glass: rgba(255,255,255,0.6);
      --card-bg: rgba(255,255,255,0.55);
      --text: #0b2540;
      --muted: #25465f;
      --shadow: 0 8px 24px rgba(14,42,84,0.08);
      --glass-border: rgba(255,255,255,0.6);
      --glass-blur: 10px;
      --glass-hover: rgba(255,255,255,0.75);
      --radius: 14px;
      --transition: 300ms cubic-bezier(.2,.9,.3,1);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    /* dark theme variables */
    :root.dark {
      --bg-1: #081129;
      --bg-2: #071824;
      --accent: #2b9cff;
      --accent-2: #1db0ff;
      --glass: rgba(255,255,255,0.03);
      --card-bg: rgba(255,255,255,0.03);
      --text: #eaf6ff;
      --muted: #9fc7ff;
      --shadow: 0 10px 30px rgba(0,0,0,0.45);
      --glass-border: rgba(255,255,255,0.06);
      --glass-blur: 8px;
      --glass-hover: rgba(255,255,255,0.05);
    }

    /* Reset & layout */
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      min-height:100%;
      color:var(--text);
      background: radial-gradient(1200px 600px at 10% 10%, var(--bg-1), transparent 20%),
                  radial-gradient(900px 500px at 90% 90%, var(--bg-2), transparent 25%);
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      transition: background var(--transition), color var(--transition);
      padding:32px;
      display:flex;
      flex-direction:column;
      gap:28px;
    }

    .container{
      max-width:1200px;
      margin:0 auto;
      width:100%;
    }

    /* Top nav */
    header {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      align-self:stretch;
      padding:8px;
      backdrop-filter: blur(var(--glass-blur));
      background: linear-gradient(180deg, rgba(255,255,255,0.4), rgba(255,255,255,0.12));
      border-radius: 12px;
      border: 1px solid var(--glass-border);
      box-shadow: var(--shadow);
      transition: background var(--transition), border var(--transition), box-shadow var(--transition);
    }

    :root.dark header{
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    }

    .logo{
      display:flex;
      gap:12px;
      align-items:center;
      text-decoration:none;
      color:var(--text);
      font-weight:700;
      font-size:1.1rem;
    }
    .logo-mark{
      width:36px;height:36px;border-radius:9px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      display:inline-grid;place-items:center;color:white;font-weight:700;
      box-shadow: 0 6px 18px rgba(37,97,182,0.18);
    }

    nav {
      display:flex;
      gap:18px;
      align-items:center;
      margin-left:auto;
      margin-right:16px;
    }
    nav a{
      text-decoration:none;color:var(--muted);font-weight:600;
      padding:8px 10px;border-radius:8px;font-size:0.95rem;
      transition: color var(--transition), background var(--transition), transform var(--transition);
    }
    nav a:hover, nav a:focus{ color:var(--text); background:rgba(0,0,0,0.04) }

    .actions{
      display:flex;gap:12px;align-items:center;
    }

    /* Dark toggle */
    .toggle {
      display:inline-grid;place-items:center;padding:6px;border-radius:10px;cursor:pointer;border:0;background:transparent;
      width:44px;height:36px;
      transition: transform var(--transition);
    }
    .toggle:focus{outline:2px solid rgba(0,0,0,0.08)}

    /* Hero */
    .hero {
      display:flex;
      gap:28px;
      align-items:center;
      padding:36px;
      border-radius:16px;
      background: linear-gradient(180deg, rgba(255,255,255,0.45), rgba(255,255,255,0.12));
      border:1px solid var(--glass-border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(var(--glass-blur));
      transition: background var(--transition), transform var(--transition);
    }
    :root.dark .hero{
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    }

    .hero-left{flex:1}
    .headline{
      font-size: clamp(1.6rem, 2.4vw, 2.4rem);
      line-height:1.05;
      margin:0 0 8px 0;
      font-weight:800;
      letter-spacing:-0.02em;
      color:var(--text);
    }
    .sub{
      margin:0 0 18px 0;color:var(--muted);font-weight:600;font-size:1rem;
    }
    .cta{
      display:inline-flex;align-items:center;gap:12px;padding:12px 18px;border-radius:12px;
      background:linear-gradient(90deg,var(--accent),var(--accent-2));color:#fff;font-weight:700;
      text-decoration:none;box-shadow:0 10px 30px rgba(37,107,218,0.2);
      transition:transform var(--transition), box-shadow var(--transition), opacity var(--transition);
    }
    .cta:active{transform:translateY(1px)}
    .cta:focus{outline:3px solid rgba(37,107,218,0.16)}

    .hero-right{
      width:380px;
      max-width:40%;
      min-width:240px;
      display:grid;
      gap:12px;
    }
    /* Floating example card group */
    .mini-card{
      padding:14px;border-radius:12px;background:var(--card-bg);
      border:1px solid var(--glass-border);backdrop-filter:blur(var(--glass-blur));
      box-shadow: var(--shadow);display:flex;align-items:center;justify-content:space-between;
    }
    .mini-card h4{margin:0;font-size:0.95rem}
    .mini-card p{margin:0;font-size:0.85rem;color:var(--muted)}

    /* Tools grid */
    .tools {
      display:grid;
      gap:16px;
      margin-top:4px;
      grid-template-columns: repeat(1, 1fr);
    }
    /* Responsive breakpoints */
    @media(min-width:520px){ .tools{ grid-template-columns: repeat(2, 1fr) } }
    @media(min-width:840px){ .tools{ grid-template-columns: repeat(3, 1fr) } }
    @media(min-width:1100px){ .tools{ grid-template-columns: repeat(4, 1fr) } }

    .tool-card{
      padding:18px;border-radius:12px;background:var(--card-bg);border:1px solid var(--glass-border);
      display:flex;gap:14px;align-items:center;transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
      cursor:pointer; user-select:none;
      backdrop-filter: blur(calc(var(--glass-blur) / 1.3));
    }
    .tool-card:focus{outline:3px solid rgba(37,107,218,0.12)}
    .tool-card:hover{
      transform: translateY(-8px) scale(1.01);
      box-shadow: 0 18px 40px rgba(10,40,90,0.12);
      background: var(--glass-hover);
    }

    .icon-wrap{
      width:56px;height:56px;border-radius:12px;display:grid;place-items:center;
      background:linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.65));
      border:1px solid rgba(255,255,255,0.6);
      transition: transform var(--transition), box-shadow var(--transition);
    }
    :root.dark .icon-wrap{
      background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border:1px solid rgba(255,255,255,0.04);
    }
    .tool-card:hover .icon-wrap{ transform: scale(1.07); box-shadow: 0 8px 18px rgba(37,107,218,0.12) }

    .tool-title{font-weight:700;margin:0}
    .tool-desc{margin:2px 0 0 0;color:var(--muted);font-size:0.88rem}

    /* Footer */
    footer{
      display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px;border-radius:12px;
      background: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0.1));
      border:1px solid var(--glass-border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(var(--glass-blur));
    }
    :root.dark footer{ background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); }
    .footer-links{display:flex;gap:14px}
    .footer-links a{text-decoration:none;color:var(--muted);font-weight:600}

    /* small screens spacing */
    @media(max-width:720px){
      body{padding:18px}
      header{flex-direction:row;gap:10px}
      .hero{flex-direction:column;align-items:flex-start}
      .hero-right{width:100%;max-width:unset}
    }

    /* focus visible */
    :focus{outline:none}
    :focus-visible{outline:3px solid rgba(37,107,218,0.12);outline-offset:3px;border-radius:8px}
  </style>
</head>
<body>
  <div class="container" role="main" aria-labelledby="site-title">
    <!-- Header -->
    <header>
      <a class="logo" href="#" id="site-title">
        <span class="logo-mark" aria-hidden="true">PP</span>
        <span>PDFPro Tools</span>
      </a>
      <nav aria-label="Primary">
        <a href="#" aria-current="page">Home</a>
        <a href="#tools">Tools</a>
        <a href="#pricing">Pricing</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="actions" role="toolbar" aria-label="Site actions">
        <button class="toggle" id="themeToggle" aria-pressed="false" title="Toggle dark mode" aria-label="Toggle dark mode">
          <!-- sun/moon svg -->
          <svg id="themeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="currentColor"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-left">
        <h1 class="headline" id="hero-heading">Convert, Edit &amp; Manage PDFs Fast and Free</h1>
        <p class="sub">All PDF tools in one simple and powerful platform.</p>
        <a class="cta" href="#tools">Start Using Tools
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="opacity:.95;margin-left:6px;">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="rgba(255,255,255,0.95)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="hero-right" aria-hidden="true">
        <div class="mini-card">
          <div>
            <h4>Fast & Secure</h4>
            <p>Files processed in-browser or securely on our servers.</p>
          </div>
          <div style="font-weight:800;color:var(--accent)">99ms</div>
        </div>
        <div class="mini-card">
          <div>
            <h4>12+ Tools</h4>
            <p>Everything from Merge to Image-to-PDF.</p>
          </div>
          <div style="font-weight:800;color:var(--accent)">Free</div>
        </div>
      </div>
    </section>

    <!-- Tools -->
    <section id="tools" class="container" aria-labelledby="tools-heading" style="padding:0">
      <h2 id="tools-heading" style="margin:8px 0 14px 6px;font-weight:800;color:var(--muted)">Popular Tools</h2>
      <div class="tools" role="list">
        <!-- Template card (12 items) -->
        <!-- 1 Merge PDF -->
        <button class="tool-card" role="listitem" aria-label="Merge PDF">
          <div class="icon-wrap" aria-hidden="true">
            <!-- merge icon -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M4 7h8v10H4z" fill="rgba(21,101,216,0.12)"/>
              <path d="M12 7h8v10h-8z" fill="rgba(43,140,255,0.12)"/>
              <path d="M8 11h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <div style="flex:1;text-align:left">
            <p class="tool-title">Merge PDF</p>
            <p class="tool-desc">Combine multiple files into one.</p>
          </div>
        </button>

        <!-- 2 Split PDF -->
        <button class="tool-card" role="listitem" aria-label="Split PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M4 5h7v7H4z" fill="rgba(21,101,216,0.12)"/>
              <path d="M13 12h7v7h-7z" fill="rgba(43,140,255,0.12)"/>
              <path d="M12 8v8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">Split PDF</p>
            <p class="tool-desc">Extract pages or split documents.</p>
          </div>
        </button>

        <!-- 3 Compress PDF -->
        <button class="tool-card" role="listitem" aria-label="Compress PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M12 5v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <circle cx="12" cy="12" r="3" fill="rgba(37,107,218,0.12)"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">Compress PDF</p>
            <p class="tool-desc">Reduce file size without losing quality.</p>
          </div>
        </button>

        <!-- 4 PDF to Word -->
        <button class="tool-card" role="listitem" aria-label="PDF to Word">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="2" fill="rgba(21,101,216,0.08)"/>
              <path d="M7 8h10M7 12h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">PDF to Word</p>
            <p class="tool-desc">Convert PDFs into editable DOCX.</p>
          </div>
        </button>

        <!-- 5 PDF to JPG -->
        <button class="tool-card" role="listitem" aria-label="PDF to JPG">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="16" height="16" rx="3" fill="rgba(43,140,255,0.08)"/>
              <circle cx="8.5" cy="8.5" r="1.6" fill="currentColor"/>
              <path d="M8 15l2-3 3 4 3-5 1.5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">PDF to JPG</p>
            <p class="tool-desc">Extract pages as high-quality images.</p>
          </div>
        </button>

        <!-- 6 JPG to PDF -->
        <button class="tool-card" role="listitem" aria-label="JPG to PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="3.5" y="4" width="17" height="16" rx="2" fill="rgba(21,101,216,0.08)"/>
              <path d="M7 8h10M7 12h10" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">JPG to PDF</p>
            <p class="tool-desc">Convert images into a single PDF.</p>
          </div>
        </button>

        <!-- 7 PDF Protector -->
        <button class="tool-card" role="listitem" aria-label="PDF Protector">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="6" y="9" width="12" height="9" rx="2" fill="rgba(37,107,218,0.08)"/>
              <path d="M9 9V7a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">PDF Protector</p>
            <p class="tool-desc">Add passwords & permissions.</p>
          </div>
        </button>

        <!-- 8 PDF Unlock -->
        <button class="tool-card" role="listitem" aria-label="PDF Unlock">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="5" y="7" width="14" height="12" rx="2" fill="rgba(43,140,255,0.08)"/>
              <path d="M8 7a4 4 0 018 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M12 12v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">PDF Unlock</p>
            <p class="tool-desc">Remove passwords (where allowed).</p>
          </div>
        </button>

        <!-- 9 Rotate PDF -->
        <button class="tool-card" role="listitem" aria-label="Rotate PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M20 12a8 8 0 10-2.7 5.6L20 12z" fill="rgba(21,101,216,0.08)"/>
              <path d="M12 4v4h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">Rotate PDF</p>
            <p class="tool-desc">Rotate pages clockwise or counterclockwise.</p>
          </div>
        </button>

        <!-- 10 Excel to PDF -->
        <button class="tool-card" role="listitem" aria-label="Excel to PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="3.5" y="3.5" width="17" height="17" rx="2" fill="rgba(21,101,216,0.08)"/>
              <path d="M7 7h10M7 12h10M7 17h6" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">Excel to PDF</p>
            <p class="tool-desc">Export spreadsheets to PDF.</p>
          </div>
        </button>

        <!-- 11 PPT to PDF -->
        <button class="tool-card" role="listitem" aria-label="PPT to PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="16" height="16" rx="2" fill="rgba(43,140,255,0.08)"/>
              <path d="M7 8h10M7 12h10" stroke="currentColor" stroke-width="1.1"/>
              <path d="M8 16h8" stroke="currentColor" stroke-width="1.1"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">PPT to PDF</p>
            <p class="tool-desc">Convert slides into printable PDFs.</p>
          </div>
        </button>

        <!-- 12 Image to PDF -->
        <button class="tool-card" role="listitem" aria-label="Image to PDF">
          <div class="icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <rect x="3.5" y="4" width="17" height="16" rx="2" fill="rgba(21,101,216,0.08)"/>
              <path d="M7 9l2 2 3-3 5 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="tool-title">Image to PDF</p>
            <p class="tool-desc">Transform photos into PDFs quickly.</p>
          </div>
        </button>

      </div>
    </section>

    <!-- Footer -->
    <footer>
      <div class="footer-left">
        <strong>PDFPro Tools</strong>
        <div style="font-size:0.92rem;color:var(--muted);margin-top:4px">© 2025 PDFPro Tools — All rights reserved.</div>
      </div>
      <div class="footer-links">
        <a href="#about">About</a>
        <a href="#privacy">Privacy Policy</a>
        <a href="#terms">Terms</a>
        <a href="#contact">Contact</a>
      </div>
    </footer>
  </div>

  <script>
    // Dark mode toggle with persistence
    (function(){
      const root = document.documentElement;
      const toggle = document.getElementById('themeToggle');
      const themeIcon = document.getElementById('themeIcon');

      // Initialize from localStorage or system preference
      const saved = localStorage.getItem('pdfpro-theme');
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const useDark = saved ? saved === 'dark' : prefersDark;

      function setTheme(dark){
        if(dark){
          root.classList.add('dark');
          toggle.setAttribute('aria-pressed','true');
          themeIcon.innerHTML = '<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" fill="currentColor"/>';
        } else {
          root.classList.remove('dark');
          toggle.setAttribute('aria-pressed','false');
          themeIcon.innerHTML = '<path d="M6.76 4.84l-1.8-1.79L3.17 4.84l1.79 1.79 1.8-1.79zM1 13h3v-2H1v2zm10 9h2v-3h-2v3zM20.84 4.84l-1.79 1.79 1.8 1.79 1.79-1.79-1.8-1.79zM23 11v2h-3v-2h3zM6.76 19.16l-1.79 1.79 1.8 1.79 1.79-1.79-1.8-1.79z"/>';
        }
        localStorage.setItem('pdfpro-theme', dark ? 'dark' : 'light');
      }

      // initial
      setTheme(useDark);

      toggle.addEventListener('click', () => {
        setTheme(!root.classList.contains('dark'));
      });

      // keyboard accessibility: press Enter or Space
      toggle.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle.click(); }
      });

    })();
  </script>
</body>
</html>
